# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
apps/mobile/build/
apps/mobile/dist/
apps/mobile/ios/build/
apps/mobile/*.ipa

# misc
.DS_Store
*.pem
History
*.p12
*.mobileprovision
AuthKey_*.p8
*.xcuserstate
xcuserdata/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# expo
apps/mobile/.expo/
apps/mobile/ios/Pods/
apps/mobile/ios/DerivedData/

# local credentials and signing
.signing/
apps/mobile/credentials/
apps/mobile/credentials.json

# local tool state and generated previews
supabase/.temp/
tmp/
apps/mobile-preview.png
apps/mobile-live-preview.png
apps/mobile-ui-parity.png
photo1-transparent.png
questhat-transparent.png
