{
  "name": "questhat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "patch-package",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "mobile": "npm run start --workspace @questhat/mobile",
    "mobile:ios": "npm run ios --workspace @questhat/mobile",
    "mobile:android": "npm run android --workspace @questhat/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @questhat/mobile",
    "apple:client-secret": "node scripts/generate-apple-client-secret.mjs"
  },
  "dependencies": {
    "@react-native-community/slider": "^5.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "heic2any": "^0.0.4",
    "i18n-iso-countries": "^7.14.0",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "next": "16.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3"
  }
}
