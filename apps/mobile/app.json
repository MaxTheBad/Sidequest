{
  "expo": {
    "name": "QuestHat",
    "slug": "questhat",
    "scheme": "questhat",
    "version": "1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.questhat.app",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "QuestHat uses the camera so you can record short quest videos and add profile or quest photos.",
        "NSMicrophoneUsageDescription": "QuestHat uses the microphone to include sound in videos you record for a quest.",
        "NSPhotoLibraryUsageDescription": "QuestHat uses your photo library so you can attach media to quests.",
        "NSLocationWhenInUseUsageDescription": "QuestHat uses your location to show nearby quests, estimate distance, and verify check-ins. Your precise location is not shown to hosts or attendees unless you explicitly choose to share it in a feature that clearly asks first.",
        "NSMotionUsageDescription": "QuestHat uses motion data to support device and media interactions in the app.",
        "ITSAppUsesNonExemptEncryption": false
      },
    "buildNumber": "95"
    },
    "android": {
      "package": "com.questhat.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#10111A"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "questhat.com",
              "pathPrefix": "/listing"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "supabaseUrl": "https://ipjewvmmzmxakoewqlfo.supabase.co/",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlwamV3dm1tem14YWtvZXdxbGZvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI4Mjg1MTYsImV4cCI6MjA4ODQwNDUxNn0.VaP8G8enHWZTfK5RtwhkRFHaeBeukuE7aWR9yyy7Io0",
      "siteUrl": "https://questhat.com",
      "eas": {
        "projectId": "269b58c4-775f-48c4-8171-196d92901c8d"
      }
    },
    "owner": "anlvio-llc",
    "plugins": [
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true,
          "defaultChannel": "questhat-updates",
          "icon": "./assets/notification-icon.png",
          "color": "#9BD8E4"
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
